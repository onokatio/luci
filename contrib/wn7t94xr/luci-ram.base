#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	local ram=/tmp/wn7-root abi=/tmp/luci-abi
	if [ ! -f /tmp/luci-ram.ready ]; then
		tar -xJf /root/luci-ram.tar.xz -C /tmp || return 1
		[ -x "$ram/usr/sbin/uhttpd" ] && [ -x "$abi/sbin/rpcd" ] || return 1
		touch /tmp/luci-ram.ready || return 1
	fi

	mkdir -p /usr/share/luci /www/luci-static || return 1
	grep -qs ' /usr/share/luci ' /proc/mounts || mount --bind "$ram/usr/share/luci" /usr/share/luci || return 1
	grep -qs ' /www/luci-static ' /proc/mounts || mount --bind "$ram/www/luci-static" /www/luci-static || return 1

	/etc/init.d/rpcd stop || return 1

	procd_open_instance rpcd
	procd_set_param command "$abi/sbin/rpcd" -s /var/run/ubus.sock
	procd_set_param env LD_LIBRARY_PATH="$abi/lib:$abi/usr/lib:/lib:/usr/lib" RPC_HANGUP=1
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance uhttpd
	procd_set_param command "$ram/usr/sbin/uhttpd" -f -p 0.0.0.0:8080 -h "$ram/www" -x /cgi-bin -u /ubus/
	procd_set_param env LD_LIBRARY_PATH="$ram/usr/lib:$abi/lib:$abi/usr/lib:/usr/lib:/lib"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
