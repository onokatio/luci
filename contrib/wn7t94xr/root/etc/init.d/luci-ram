#!/bin/sh /etc/rc.common

START=99
STOP=89
EXTRA_COMMANDS=fetch
EXTRA_HELP="fetch  Download and verify the complete LuCI runtime into RAM"

ram=/tmp/luci-ram
state=/overlay/luci-ram
manifest=/etc/luci-qsdk/ram-packages
dirs='usr/lib/lua usr/lib/ucode usr/lib/rpcd usr/libexec usr/lib/opkg usr/lib/sqm etc/sqm usr/share www lib/netifd/wireless'
bindings='etc/init.d/network sbin/wifi etc/board.json'

fetch() {
	local digest download unpack name version sha url database
	digest="$(sha256sum "$manifest" | cut -d ' ' -f 1)" || return 1
	[ ! -L "$ram" ] || return 1
	if [ -d "$ram" ]; then
		[ "$(stat -c '%u:%a' "$ram")" = 0:755 ] &&
		   [ "$(cat "$ram/.manifest-sha256")" = "$digest" ] &&
		   [ -x "$ram/usr/sbin/uhttpd" ] && [ -f "$ram/www/cgi-bin/luci" ]
		return $?
	fi
	download="$(mktemp -d /tmp/luci-download.XXXXXX)" || return 1
	unpack="$(mktemp -d /tmp/luci-unpack.XXXXXX)" || { rm -rf "$download"; return 1; }
	mkdir -p "$unpack/usr/lib/opkg/info" "$unpack/var/lock" "$unpack/tmp" || { rm -rf "$unpack" "$download"; return 1; }
	database=/usr/lib/opkg/status
	[ ! -f "$state/upper/usr/lib/opkg/status" ] || database="$state/upper/usr/lib/opkg/status"
	awk 'BEGIN { packages["luci-qsdk-wn7t94xr"]=1; packages["luci-qsdk-wn7t94xr-prepare"]=1 } NR==FNR { packages[$1]=1; next } /^Package: / { skip=($2 in packages) } !skip { print }' \
		"$manifest" "$database" > "$download/stock-status" || { rm -rf "$unpack" "$download"; return 1; }
	awk '/^Package: / { keep=($2=="luci-qsdk-wn7t94xr" || $2=="luci-qsdk-wn7t94xr-prepare") } keep { print }' \
		/usr/lib/opkg/status >> "$download/stock-status" || { rm -rf "$unpack" "$download"; return 1; }
	set --
	while read -r name version sha url; do
		if ! curl -fsSL --retry 4 --retry-delay 3 --retry-all-errors --connect-timeout 10 --max-time 45 "$url" -o "$download/$name.ipk" ||
		   [ "$(sha256sum "$download/$name.ipk" | cut -d ' ' -f 1)" != "$sha" ]; then
			rm -rf "$unpack" "$download"
			logger -t luci-ram "LuCI package download or verification failed: $name"
			return 1
		fi
		set -- "$@" "$download/$name.ipk"
	done < "$manifest"
	# The pinned manifest is dependency-checked at build time; never resolve feeds or run hooks here.
	printf 'dest root /\narch all 1\narch arm_cortex-a7_neon-vfpv4 10\n' > "$download/opkg.conf"
	if ! IPKG_NO_SCRIPT=1 opkg -f "$download/opkg.conf" --offline-root "$unpack" --tmp-dir "$download" --nodeps install "$@" > "$download/install.log" 2>&1; then
		cat "$download/install.log" >&2
		rm -rf "$unpack" "$download"
		logger -t luci-ram 'LuCI offline package installation failed'
		return 1
	fi
	cat "$download/stock-status" >> "$unpack/usr/lib/opkg/status" || { rm -rf "$unpack" "$download"; return 1; }
	while read -r name version sha url; do
		if [ "$(sed -n 's/^Package: //p' "$unpack/usr/lib/opkg/info/$name.control")" != "$name" ] ||
		   [ "$(sed -n 's/^Version: //p' "$unpack/usr/lib/opkg/info/$name.control")" != "$version" ]; then
			rm -rf "$unpack" "$download"
			logger -t luci-ram "LuCI package identity verification failed: $name"
			return 1
		fi
		# Persistent settings and bootstrap links must not become RAM package removal targets.
		if ! sed -e '/\/$/d' -e '/^\/etc\//d' -e '/^\/sbin\/luci-reload$/d' -e '/^\/sbin\/wifi$/d' \
		     -e '/^\/lib\/upgrade\/keep.d\//d' \
		     -e '/^\/usr\/bin\/ucode$/d' -e '/^\/usr\/sbin\/uhttpd$/d' -e '/^\/usr\/libexec\/cgi-io$/d' \
		     -e '/^\/usr\/lib\/libiwinfo.so.20230701$/d' -e '/^\/usr\/lib\/liblucihttp.so$/d' -e '/^\/usr\/lib\/liblucihttp.so.0$/d' \
		     -e '/^\/usr\/lib\/uhttpd_ubus.so$/d' \
		     "$unpack/usr/lib/opkg/info/$name.list" > "$download/filelist" ||
		   ! mv "$download/filelist" "$unpack/usr/lib/opkg/info/$name.list"; then
			rm -rf "$unpack" "$download"
			return 1
		fi
	done < "$manifest"
	[ -x "$unpack/usr/sbin/uhttpd" ] && [ -x "$unpack/usr/bin/ucode" ] && [ -f "$unpack/usr/share/ucode/luci/dispatcher.uc" ] &&
	   [ -f "$unpack/lib/netifd/wireless/qcawificfg80211.sh" ] &&
	   [ -f "$unpack/etc/init.d/network" ] && [ -f "$unpack/sbin/wifi" ] || { rm -rf "$unpack" "$download"; return 1; }
	# Supply board metadata in RAM; the vendor file is restored when LuCI stops.
	if ! (
		[ "$(tr '\000' '\n' </sys/firmware/devicetree/base/compatible | head -n 1)" = qcom,ipq5332-ap-mi01.6 ] || exit 1
		[ "$(tr -d '\000' </sys/firmware/devicetree/base/soc/ess-instance/ess-switch1@1/compatible)" = qcom,ess-switch-qca8386 ] &&
		[ "$(tr -d '\000' </sys/firmware/devicetree/base/aliases/ethernet1)" = /soc/dp2 ] &&
		[ "$(cat /sys/class/net/eth1/type)" = 1 ] || exit 1
		for property in device_id:00000001 switch_cpu_bmp:00000001 switch_lan_bmp:0000000e switch_wan_bmp:00000000; do
			[ "$(hexdump -v -e '1/1 "%02x"' /sys/firmware/devicetree/base/soc/ess-instance/ess-switch1@1/${property%:*})" = "${property#*:}" ] || exit 1
		done
		for property in qcom,id qcom,is_switch_connected qcom,mht-dev; do
			[ "$(hexdump -v -e '1/1 "%02x"' /sys/firmware/devicetree/base/soc/dp2/$property)" = 00000001 ] || exit 1
		done
		. /usr/share/libubox/jshn.sh
		json_load_file /etc/board.json || exit 1
		for object in switch switch1; do
			json_get_type type "$object"
			case "$type" in '') json_add_object "$object";; object) json_select "$object";; *) json_dump; exit 0;; esac
		done
		json_get_type type ports
		[ -z "$type" ] || [ "$type" = array ] || { json_dump; exit 0; }
		if [ "$type" = array ]; then json_select ports; else json_add_array ports; fi
		json_get_keys keys
		if [ -z "$keys" ]; then
			for port in 0 1 2 3; do
				json_add_object; json_add_int num "$port"
				if [ "$port" = 0 ]; then json_add_string device eth1; json_add_boolean need_tag 0
				else json_add_string role lan; json_add_int index "$port"; fi
				json_close_object
			done
		fi
		json_dump
	) > "$unpack/etc/board.json"; then rm -rf "$unpack" "$download"; return 1; fi
	printf '%s\n' "$digest" > "$unpack/.manifest-sha256"
	chmod 755 "$unpack"
	mv "$unpack" "$ram" || { rm -rf "$unpack" "$download"; return 1; }
	rm -rf "$download"
	logger -t luci-ram 'Verified all LuCI packages and unpacked them in RAM'
}

owns_mount() {
	grep -F " /$1 overlay " /proc/mounts | grep -Fq "upperdir=$state/upper/$1,"
}

start() {
	# Finish every download before changing the vendor service or filesystem view.
	fetch || { /etc/init.d/sqm start; return 1; }
	[ ! -L "$state" ] || return 1
	for dir in $dirs; do
		owns_mount "$dir" && continue
		grep -Fq " /$dir " /proc/mounts && return 1
	done
	for file in $bindings; do
		[ "/$file" -ef "$ram/$file" ] && continue
		grep -Fq " /$file " /proc/mounts && return 1
	done
	mount -o remount,compr=zlib /overlay || return 1
	mkdir -p "$state" || return 1
	chmod 700 "$state"
	for dir in $dirs; do
		owns_mount "$dir" && continue
		mkdir -p "/$dir" "$ram/$dir" "$state/upper/$dir" "$state/work/$dir" || { stop; return 1; }
		mount -t overlay overlay -o "lowerdir=$ram/$dir:/$dir,upperdir=$state/upper/$dir,workdir=$state/work/$dir" "/$dir" || { stop; return 1; }
	done
	for file in $bindings; do
		[ "/$file" -ef "$ram/$file" ] && continue
		mount --bind "$ram/$file" "/$file" || { stop; return 1; }
	done
	if [ -f "$state/upper/usr/lib/opkg/status" ]; then
		awk 'BEGIN { packages["luci-qsdk-wn7t94xr"]=1; packages["luci-qsdk-wn7t94xr-prepare"]=1 } NR==FNR { packages[$1]=1; next } /^Package: / { skip=($2 in packages) } !skip { print }' \
			"$manifest" "$state/upper/usr/lib/opkg/status" > "$ram/opkg-status.new" || { stop; return 1; }
		awk 'BEGIN { packages["luci-qsdk-wn7t94xr"]=1; packages["luci-qsdk-wn7t94xr-prepare"]=1 } NR==FNR { packages[$1]=1; next } /^Package: / { keep=($2 in packages) } keep { print }' \
			"$manifest" "$ram/usr/lib/opkg/status" >> "$ram/opkg-status.new" || { stop; return 1; }
		cat "$ram/opkg-status.new" > /usr/lib/opkg/status || { stop; return 1; }
		rm -f "$ram/opkg-status.new"
	fi
	if [ ! -f "$ram/.started" ]; then
		# netifd discovers wireless driver scripts only when its process starts.
		/etc/init.d/rpcd restart || { stop; return 1; }
		/etc/init.d/network restart || { stop; return 1; }
		ubus -t 30 wait_for network.interface || { stop; return 1; }
		rm -rf /tmp/luci-modulecache
		rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*.json
		"$ram/etc/init.d/ucitrack" start || { stop; return 1; }
		"$ram/etc/init.d/uhttpd" start || { stop; return 1; }

		touch "$ram/.started"
	fi
	if [ -x /etc/init.d/sqm ]; then
		/etc/init.d/sqm enable || return 1
		/etc/init.d/sqm start || logger -t luci-ram 'SQM did not start; inspect its configuration and log'
	fi
}

stop() {
	local mounted=0 result=0
	for dir in $dirs; do owns_mount "$dir" && mounted=1; done
	for file in $bindings; do [ "/$file" -ef "$ram/$file" ] && mounted=1; done
	[ "$mounted" = 1 ] || return 0
	rm -f "$ram/.started"
	[ ! -x /etc/init.d/sqm ] || SQM_QSDK_RELEASE_ACCEL=1 /etc/init.d/sqm stop || return 1
	[ ! -x /etc/init.d/sqm ] || /etc/init.d/sqm disable || return 1
	[ ! -x "$ram/etc/init.d/uhttpd" ] || "$ram/etc/init.d/uhttpd" stop
	[ ! -x "$ram/etc/init.d/ucitrack" ] || "$ram/etc/init.d/ucitrack" stop
	/etc/init.d/rpcd stop
	# Keep routing active if a busy mount prevents restoring the vendor view.
	for file in etc/board.json sbin/wifi etc/init.d/network; do
		[ ! "/$file" -ef "$ram/$file" ] || umount "/$file" || result=1
	done
	for dir in lib/netifd/wireless www usr/share etc/sqm usr/lib/sqm usr/lib/opkg usr/libexec usr/lib/rpcd usr/lib/ucode usr/lib/lua; do
		owns_mount "$dir" || continue
		if ! umount "/$dir"; then
			# netifd retains a directory fd until the network restart below.
			[ "$dir" = lib/netifd/wireless ] && umount -l "/$dir" || result=1
		fi
	done
	/etc/init.d/rpcd start
	[ "$result" = 0 ] || return 1
	/etc/init.d/network restart || return 1
	[ ! -L "$ram" ] && [ "$(stat -c '%u' "$ram")" = 0 ] || return 1
	rm -rf "$ram"
}

shutdown() {
	[ ! -x "$ram/etc/init.d/uhttpd" ] || "$ram/etc/init.d/uhttpd" stop
}
