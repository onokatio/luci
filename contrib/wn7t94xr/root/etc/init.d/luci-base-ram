#!/bin/sh /etc/rc.common

START=95
STOP=89
EXTRA_COMMANDS=fetch
EXTRA_HELP="fetch  Download, verify and unpack the official LuCI base into RAM"

ram=/tmp/luci-base
state=/overlay/luci-base
sha=@BASE_SHA@
url=@BASE_URL@
dirs='usr/lib/lua usr/libexec/rpcd usr/share www'

fetch() {
	[ ! -L "$ram" ] || return 1
	if [ -d "$ram" ]; then
		[ "$(stat -c '%u' "$ram")" = 0 ] && [ "$(cat "$ram/.archive-sha256")" = "$sha" ] &&
		   [ -f "$ram/usr/lib/lua/luci/dispatcher.lua" ] && [ -f "$ram/www/cgi-bin/luci" ]
		return $?
	fi
	local download unpack
	download="$(mktemp -d /tmp/luci-base-download.XXXXXX)" || return 1
	if ! curl -fsSL --connect-timeout 10 --max-time 45 "$url" -o "$download/base.ipk" ||
	   [ "$(sha256sum "$download/base.ipk" | cut -d ' ' -f 1)" != "$sha" ]; then
		rm -rf "$download"
		logger -t luci-base-ram 'LuCI base download or SHA-256 verification failed'
		return 1
	fi
	unpack="$(mktemp -d /tmp/luci-base-unpack.XXXXXX)" || { rm -rf "$download"; return 1; }
	tar -xzf "$download/base.ipk" -C "$download" ./data.tar.gz &&
	   tar -xzf "$download/data.tar.gz" -C "$unpack" || { rm -rf "$unpack" "$download"; return 1; }
	[ -f "$unpack/usr/lib/lua/luci/dispatcher.lua" ] && [ -f "$unpack/www/cgi-bin/luci" ] || { rm -rf "$unpack" "$download"; return 1; }
	printf '%s\n' "$sha" > "$unpack/.archive-sha256"
	chmod 755 "$unpack"
	mv "$unpack" "$ram" || { rm -rf "$unpack" "$download"; return 1; }
	rm -rf "$download"
	logger -t luci-base-ram 'Verified LuCI base downloaded and unpacked in RAM'
}

owns_mount() {
	grep -F " /$1 overlay " /proc/mounts | grep -Fq "upperdir=$state/upper/$1,"
}

start() {
	fetch || {
		logger -t luci-base-ram 'LuCI base download failed; SSH and vendor services remain available'
		return 1
	}
	[ ! -L "$ram" ] && [ "$(cat "$ram/.archive-sha256")" = "$sha" ] || return 1
	[ ! -L "$state" ] || return 1
	mount -o remount,compr=zlib /overlay || return 1
	mkdir -p "$state" || return 1
	chmod 700 "$state"
	for dir in $dirs; do
		owns_mount "$dir" && continue
		grep -Fq " /$dir " /proc/mounts && return 1
	done
	for dir in $dirs; do
		owns_mount "$dir" && continue
		mkdir -p "/$dir" "$state/upper/$dir" "$state/work/$dir" || { stop; return 1; }
		mount -t overlay overlay -o "lowerdir=/$dir:$ram/$dir,upperdir=$state/upper/$dir,workdir=$state/work/$dir" "/$dir" || { stop; return 1; }
	done
	/etc/init.d/rpcd restart
	[ ! -x /etc/init.d/uhttpd ] || /etc/init.d/uhttpd restart
}

stop() {
	[ ! -x /etc/init.d/uhttpd ] || /etc/init.d/uhttpd stop
	/etc/init.d/rpcd stop
	for dir in www usr/share usr/libexec/rpcd usr/lib/lua; do
		owns_mount "$dir" || continue
		umount "/$dir" || return 1
	done
	if [ ! -L "$ram" ] && [ "$(stat -c '%u' "$ram" 2>/dev/null)" = 0 ] &&
	   grep -Eq '^[0-9a-f]{64}$' "$ram/.archive-sha256" 2>/dev/null; then
		rm -rf "$ram"
	fi
}
