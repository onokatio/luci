	"admin/network/acceleration": {
		"title": "Acceleration",
		"order": 25,
		"action": {
			"type": "view",
			"path": "network/acceleration"
		},
		"depends": {
			"acl": [
				"luci-qsdk-acceleration"
			],
			"fs": {
