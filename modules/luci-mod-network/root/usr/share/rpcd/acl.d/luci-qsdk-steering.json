{
  "luci-qsdk-steering": {
    "description": "Manage native standalone band steering",
    "read": {
      "file": {
        "/etc/init.d/lbd enabled": [
          "exec"
        ],
        "/usr/sbin/repacdcli athx get_all_freq": [
          "exec"
        ]
      },
      "ubus": {
        "service": [
          "list"
        ]
      },
      "uci": [
        "lbd",
        "repacd",
        "ezmesh",
        "hyd"
      ]
    },
    "write": {
      "file": {
        "/etc/init.d/lbd disable": [
          "exec"
        ],
        "/etc/init.d/lbd enable": [
          "exec"
        ],
        "/etc/init.d/lbd restart": [
          "exec"
        ],
        "/etc/init.d/lbd stop": [
          "exec"
        ]
      },
      "uci": [
        "lbd"
      ]
    }
  }
}
