{
  "luci-qsdk-acceleration": {
    "description": "Manage the native QSDK connection accelerator",
    "read": {
      "ubus": {
        "luci-rpc": [
          "getAccelerationStatus"
        ]
      },
      "uci": [
        "ecm",
        "sqm"
      ]
    },
    "write": {
      "file": {
        "/etc/init.d/qca-nss-ecm restart": [
          "exec"
        ]
      },
      "ubus": {
        "file": [
          "exec"
        ],
        "uci": [
          "set",
          "commit"
        ]
      },
      "uci": [
        "ecm"
      ]
    }
  }
}
