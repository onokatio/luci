{
  "luci-qsdk-wireless": {
    "description": "Manage the native QSDK wireless services",
    "read": {
      "ubus": {
        "hostapd.*": [
          "get_clients",
          "get_status",
          "get_features"
        ],
        "luci-rpc": [
          "getWirelessSettings",
          "getWirelessDiagnostics",
          "getWirelessDscpMap",
          "getWirelessWmm"
        ]
      },
      "uci": [
        "wireless"
      ]
    },
    "write": {
      "uci": [
        "wireless"
      ]
    }
  }
}
