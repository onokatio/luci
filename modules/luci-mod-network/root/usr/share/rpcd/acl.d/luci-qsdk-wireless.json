{
  "luci-qsdk-wireless": {
    "description": "Manage the native QSDK wireless services",
    "read": {
      "uci": ["wireless"],
      "ubus": {"hostapd.*": ["wps_status", "rrm_nr_list"], "luci-rpc": ["getWirelessSettings"]}
    },
    "write": {
      "uci": ["wireless"],
      "ubus": {"hostapd.*": ["wps_start", "wps_cancel", "bss_transition_request", "rrm_beacon_req", "qsdk_rrm_nr_add", "qsdk_rrm_nr_remove"]}
    }
  }
}
